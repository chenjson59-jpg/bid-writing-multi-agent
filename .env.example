# DeepSeek模型 - 获取API密钥：https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# LLM 模型配置（实际运行走火山方舟 OpenAI 兼容端点，模型名按账号可见型号填写）
LLM_PROVIDER=deepseek
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
LLM_TIMEOUT=120
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=32768
# 抽取/写作属机械任务，关闭思考链可显著提速（deepseek 思考默认开启会挤占输出预算）
LLM_THINKING=disabled

# 火山方舟模型 - 获取API密钥：https://console.volcengine.com/ark
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 嵌入模型配置（本机实测 doubao-embedding-vision，2048 维；
# 也可换 doubao-embedding-large，支持 4096/2048/1024/512 维。
# 若账号只开通了 coding 端点，把 EMBEDDING_BASE_URL 换成 .../api/coding/v3）
EMBEDDING_MODEL=doubao-embedding-vision
EMBEDDING_DIMENSIONS=2048
EMBEDDING_BATCH_SIZE=10
# Chroma 向量库目录
# 启动命令：chroma run --path ./chroma_db
# 接口文档：http://localhost:8000/docs
CHROMA_DIR=./chroma_db

# API服务配置
# 默认仅本机监听；上传接口会触发付费解析，如需局域网访问请自行加鉴权
API_HOST=127.0.0.1
API_PORT=8001
API_MAX_UPLOAD_MB=200
API_MAX_CONCURRENT_PARSES=1
API_MAX_PENDING_JOBS=2
# 允许的跨域来源，逗号分隔；null 用于 Electron 打包后的 file:// 页面
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,null
# 公网部署时设置：/api 需携带 X-API-Token 头或 ?token= 参数；留空则不校验
API_TOKEN=

# 任务队列（Celery + Redis）
TASK_BACKEND=celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Windows 下不要用 prefork；可选 solo / threads
CELERY_WORKER_POOL=solo
CELERY_RESULT_EXPIRES=86400
CELERY_TASK_ALWAYS_EAGER=false

# 多 Agent 投标文件编写
BID_WRITER_MAX_REVISIONS=1
BID_WRITER_MIN_SCORE=75
BID_WRITER_TOP_K=6
BID_WRITER_MAX_CONCURRENCY=3
BID_WRITER_TARGET_WORDS=1200

# PostgreSQL 数据库（可选增强：任务历史与投标人资料；留空则自动降级，主链路不受影响）
DATABASE_URL=postgresql+asyncpg://postgres:123456@localhost:5432/bidding
# Redis 缓存
REDIS_URL=redis://localhost:6379/0

# MinerU 模型配置 - 获取API密钥：https://mineru.net/apiManage/token
# API密钥有效期 90 天，过期后需要重新获取
# 文档：https://mineru.net/apiManage/docs
MINERU_MODE=cloud
MINERU_API_KEY=
# 单文件解析 API：仅接受公网可访问的 http(s) 链接，不能直接上传本地文件
# 本地文件请使用下方 *_BATCH_* 两个新键（批量上传流程）
MINERU_ENDPOINT=https://mineru.net/api/v4/extract/task
# 本地上传流程
MINERU_BATCH_UPLOAD_ENDPOINT=https://mineru.net/api/v4/file-urls/batch
MINERU_BATCH_RESULT_ENDPOINT=https://mineru.net/api/v4/extract-results/batch/{batch_id}
MINERU_TIMEOUT=180
MINERU_DOWNLOAD_TIMEOUT=300
MINERU_MODEL_VERSION=vlm
MINERU_POLL_INTERVAL=5
MINERU_MAX_POLLS=120
MINERU_MAX_RETRIES=2
MINERU_RETRY_BACKOFF=2.0
MINERU_LANGUAGE=ch
MINERU_ENABLE_FORMULA=true
MINERU_ENABLE_TABLE=true
MINERU_IS_OCR=false
MINERU_MAX_FILE_MB=200
# 单次提交页数上限；超过则自动分片
MINERU_MAX_PAGES=200
